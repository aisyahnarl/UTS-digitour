{
    "functions": {
        "api/**/*.php": {
            "runtime": "vercel-php@0.7.2"
        }
    },
    "routes": [
        { "src": "/assets/(.*)", "dest": "/assets/$1" },
        { "src": "/login.php", "dest": "/api/login.php" },
        { "src": "/logout.php", "dest": "/api/logout.php" },
        { "src": "/register.php", "dest": "/api/register.php" },
        { "src": "/auth.php", "dest": "/api/auth.php" },
        { "src": "/dashboard.php", "dest": "/api/dashboard.php" },
        { "src": "/tour.php", "dest": "/api/tour.php" },
        { "src": "/map_real.php", "dest": "/api/map_real.php" },
        { "src": "/manage_destinasi.php", "dest": "/api/manage_destinasi.php" },
        { "src": "/edit_destinasi.php", "dest": "/api/edit_destinasi.php" },
        { "src": "/proses_register.php", "dest": "/api/proses_register.php" },
        { "src": "/api_wisman.php", "dest": "/api/api_wisman.php" },
        { "src": "/api_provinsi.php", "dest": "/api/api_provinsi.php" },
        { "src": "/api_kabupaten.php", "dest": "/api/api_kabupaten.php" },
        { "src": "/index.php", "dest": "/api/index.php" },
        { "src": "/", "dest": "/api/index.php" }
    ]
}